# ─────────────────────────────────────────────────────────────────────────────
# Production environment for the single-host deployment.
#
# Copy to `.env` ON THE SERVER, next to docker-compose.prod.yml, and fill in the
# blanks. Never commit the result: it holds the database password and the API
# key. `.env` is gitignored, and `git checkout` during deploy leaves it alone
# because it is untracked.
#
# Values that docker-compose.prod.yml sets for you and that do NOT belong here:
#   POSTGRES_HOST / POSTGRES_PORT / REDIS_HOST / REDIS_PORT / TRUST_PROXY
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment ───────────────────────────────────────────────────────────────
# Deliberately no DOMAIN: this stack no longer terminates TLS. The shared edge
# Caddy holds the certificate for triage-engine.youneskaouani.dev along with the
# other two sites on the box — see the deploy/edge directory of the portfolio
# repository. Its A record must still resolve here before that Caddy first
# starts, or ACME will fail for this name.
#
# Rewritten by the deploy job to the exact image built for the deployed commit.
APP_IMAGE=ghcr.io/youneskaouani/triage-engine:latest

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=triage
# Generate one, do not reuse the dev default: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=triage
# Safe with a single app container. With more than one replica, turn this off
# and run migrations as an explicit step so instances don't race on startup.
DB_RUN_MIGRATIONS_ON_BOOT=true

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis is on the egress-less internal network and unreachable from outside the
# host, so no password is set. If you ever publish its port, change that.
REDIS_PASSWORD=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per client IP, over RATE_LIMIT_TTL_MS. Writes are capped harder than reads
# because they create rows and queue jobs.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_WRITES=20

# ── Retention ────────────────────────────────────────────────────────────────
# On by default in production: this is a public demo anyone can POST to, and
# idempotency_keys grows without bound by design (ADR-0001). Only terminal rows
# are pruned; live work is never touched regardless of age.
RETENTION_ENABLED=true
RETENTION_SWEEP_INTERVAL_MS=3600000
RETENTION_MAX_AGE_MS=604800000

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_MAX_ATTEMPTS=5
PIPELINE_BACKOFF_BASE_MS=2000
PIPELINE_BACKOFF_MAX_MS=60000
IDEMPOTENCY_LEASE_MS=300000

# ── Outbox relay ─────────────────────────────────────────────────────────────
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_MS=2000
# Left unset, compose points this at the bundled loopback sink so the demo works
# end to end. Set it to a real consumer to dispatch off-box.
WEBHOOK_TARGET_URL=

# ── Mistral ──────────────────────────────────────────────────────────────────
# Leave blank to run the demo entirely on the rule-based fallback: the app boots
# and classifies tickets as DEGRADED rather than failing. Set it to exercise the
# real model path — note that live traffic then costs money.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_MS=10000
MISTRAL_MAX_RETRIES=2
MISTRAL_SERVER_URL=

# ── Degradation recovery ─────────────────────────────────────────────────────
ENRICHMENT_UPGRADE_MAX_ATTEMPTS=5
ENRICHMENT_UPGRADE_BACKOFF_MS=30000
RECONCILE_SWEEP_INTERVAL_MS=60000
RECONCILE_DEGRADED_AFTER_MS=300000
RECONCILE_BATCH_SIZE=50

# ── Circuit breaker ──────────────────────────────────────────────────────────
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=12000
CIRCUIT_BREAKER_RESET_MS=30000
