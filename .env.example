# ─────────────────────────────────────────────────────────────────────────────
# triage-engine configuration
# Copy to `.env` (used by docker-compose and local runs). Every value below has a
# safe default in code EXCEPT MISTRAL_API_KEY. The app boots and degrades to the
# rule-based classifier if MISTRAL_API_KEY is absent — it never crashes for it.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Host is `postgres` inside docker-compose, `localhost` when running the app on host.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage
# Run migrations automatically on boot (handy for the demo stack; prefer an
# explicit `make migrate` step in real deployments).
DB_RUN_MIGRATIONS_ON_BOOT=true

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Leave blank for no auth (local default).
REDIS_PASSWORD=

# ── Pipeline (BullMQ retry policy) ───────────────────────────────────────────
# Total attempts before a job is dead-lettered.
PIPELINE_MAX_ATTEMPTS=5
# Exponential backoff base; effective delay = base * 2^(attempt-1) + jitter.
PIPELINE_BACKOFF_BASE_MS=2000
PIPELINE_BACKOFF_MAX_MS=60000

# ── Idempotency ──────────────────────────────────────────────────────────────
# A PENDING idempotency row whose lease (locked_at) is older than this is treated
# as abandoned and may be re-driven. See ADR-0001.
IDEMPOTENCY_LEASE_MS=300000

# ── Outbox relay ─────────────────────────────────────────────────────────────
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=20
# After this many failed dispatch attempts the message goes terminal (FAILED) and
# is no longer polled; outbox_messages_failed_total is incremented. See ADR-0004.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_MS=2000
# Simulated downstream notification target. Any URL; the relay POSTs to it.
# Leave as the loopback sink to run fully offline.
WEBHOOK_TARGET_URL=http://localhost:3000/_sink/webhook

# ── Mistral AI (enrichment — added in the AI layer) ──────────────────────────
# Read from env ONLY. Never commit a real key. Absent key => graceful degradation.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_MS=10000
MISTRAL_MAX_RETRIES=2
# Override the SDK base URL (tests point this at a local mock HTTP server). Leave
# blank to use the real Mistral API.
MISTRAL_SERVER_URL=

# ── Graceful-degradation re-enrichment ───────────────────────────────────────
# When the AI is down a ticket is classified by the fallback (status DEGRADED) and
# re-queued on a delay to attempt an AI upgrade later. Decoupled from breaker
# state to avoid a thundering herd on recovery (ADR-0005).
ENRICHMENT_UPGRADE_MAX_ATTEMPTS=5
ENRICHMENT_UPGRADE_BACKOFF_MS=30000

# ── Reconciliation sweep (ADR-0009) ──────────────────────────────────────────
# Backstop that re-drives tickets stuck in DEGRADED (lost upgrade job, crash, or
# exhausted upgrade attempts) so none stays degraded forever.
RECONCILE_SWEEP_INTERVAL_MS=60000
RECONCILE_DEGRADED_AFTER_MS=300000
RECONCILE_BATCH_SIZE=50

# ── Circuit breaker (opossum, wraps the Mistral call) ────────────────────────
# Open after this % of requests fail within the rolling window...
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
# ...but only once at least this many requests have been observed (avoids opening
# on a single early failure).
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
# Per-call timeout enforced by the breaker (backstop above MISTRAL_TIMEOUT_MS).
CIRCUIT_BREAKER_TIMEOUT_MS=12000
# How long the breaker stays open before a half-open probe.
CIRCUIT_BREAKER_RESET_MS=30000
